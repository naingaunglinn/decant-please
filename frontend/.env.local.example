# Laravel API base — the storefront appends /v1/{shop} per resolved tenant, and
# /v1/_storefront/host/{host} to resolve one. Also decides where uploaded images
# are optimized from (see next.config.ts).
NEXT_PUBLIC_API_URL=http://localhost:8010/api

# There is deliberately NO per-shop variable here (ADR-0004, PR-B): one storefront
# deployment serves every shop, and the tenant comes from the request Host resolved
# against the backend's shop_domains table. Locally, the seeder maps
# localhost:3001 → decant-please, so `npm run dev -- -p 3001` just works.
# NEXT_PUBLIC_SHOP_SLUG and NEXT_PUBLIC_SITE_URL are retired — canonical/OG/sitemap
# URLs now derive from each shop's verified primary domain.

# Production only: the Cloudflare R2 public image host, added to next.config.ts's image
# remotePatterns. Leave unset locally — in dev, images are served from the API host's
# /storage path, which is already allow-listed.
# NEXT_PUBLIC_IMAGE_URL=https://images.cornerarea.me
